/* Tree-Size light theme */
QWidget {
    background-color: #f5f5f5;
    color: #1a1a1a;
    font-family: "Segoe UI", sans-serif;
    font-size: 9pt;
}

QMainWindow {
    background-color: #f0f0f0;
}

/* ── Toolbar ─────────────────────────────────────────────── */
QToolBar {
    background-color: #e8e8e8;
    border-bottom: 1px solid #cccccc;
    spacing: 4px;
    padding: 2px 4px;
}

QToolBar QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 3px;
    padding: 3px 8px;
}

QToolBar QToolButton:hover {
    background-color: #d0d8e8;
    border-color: #aabbcc;
}

QToolBar QToolButton:pressed {
    background-color: #b8c8dc;
}

QToolBar QToolButton:disabled {
    color: #aaaaaa;
}

/* ── Status bar ──────────────────────────────────────────── */
QStatusBar {
    background-color: #e0e0e0;
    color: #444444;
}

QStatusBar QLabel {
    background-color: transparent;
    padding: 0px 4px;
}

/* ── Progress bar (inside status bar) ───────────────────── */
QProgressBar {
    border: 1px solid #bbbbbb;
    border-radius: 3px;
    background-color: #f0f0f0;
    height: 12px;
}

QProgressBar::chunk {
    background-color: #4a90d9;
    border-radius: 2px;
}

/* ── Tree view ───────────────────────────────────────────── */
QTreeView {
    background-color: #ffffff;
    alternate-background-color: #f2f6fb;
    border: none;
}

QTreeView::item:selected {
    background-color: #4a90d9;
    color: #ffffff;
}

QTreeView::item:hover {
    background-color: #ddeeff;
}

QHeaderView::section {
    background-color: #e8e8e8;
    border: none;
    border-right: 1px solid #cccccc;
    border-bottom: 1px solid #cccccc;
    padding: 2px 6px;
}

/* ── Search bar inputs ───────────────────────────────────── */
QLineEdit {
    background-color: #ffffff;
    border: 1px solid #c0c0c0;
    border-radius: 3px;
    padding: 2px 5px;
    selection-background-color: #4a90d9;
    selection-color: #ffffff;
}

QLineEdit:focus {
    border-color: #4a90d9;
}

QComboBox {
    background-color: #ffffff;
    border: 1px solid #c0c0c0;
    border-radius: 3px;
    padding: 2px 5px;
}

QComboBox:focus {
    border-color: #4a90d9;
}

QComboBox::drop-down {
    border: none;
    width: 16px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #cccccc;
    selection-background-color: #4a90d9;
    selection-color: #ffffff;
}

QSpinBox {
    background-color: #ffffff;
    border: 1px solid #c0c0c0;
    border-radius: 3px;
    padding: 2px 5px;
}

QSpinBox:focus {
    border-color: #4a90d9;
}

QCheckBox {
    spacing: 5px;
}

QCheckBox::indicator {
    width: 13px;
    height: 13px;
    border: 1px solid #aaaaaa;
    border-radius: 2px;
    background-color: #ffffff;
}

QCheckBox::indicator:checked {
    background-color: #4a90d9;
    border-color: #3a80c9;
}

/* ── Splitter handle ─────────────────────────────────────── */
QSplitter::handle {
    background-color: #cccccc;
    width: 3px;
}

/* ── Bar chart panel ─────────────────────────────────────── */
#BarChartTitle {
    font-weight: bold;
    font-size: 10pt;
    color: #333333;
    padding: 2px 0px;
}

/* ── Dialogs ─────────────────────────────────────────────── */
QDialog {
    background-color: #f5f5f5;
}

QPushButton {
    background-color: #e8e8e8;
    border: 1px solid #bbbbbb;
    border-radius: 3px;
    padding: 4px 12px;
}

QPushButton:hover {
    background-color: #d0d8e8;
    border-color: #aabbcc;
}

QPushButton:pressed {
    background-color: #b8c8dc;
}

QPushButton:default {
    border-color: #4a90d9;
    background-color: #4a90d9;
    color: #ffffff;
}

QPushButton:default:hover {
    background-color: #3a80c9;
}

/* ── Context menu ────────────────────────────────────────── */
QMenu {
    background-color: #ffffff;
    border: 1px solid #cccccc;
}

QMenu::item {
    padding: 4px 20px;
}

QMenu::item:selected {
    background-color: #4a90d9;
    color: #ffffff;
}

QMenu::separator {
    height: 1px;
    background-color: #dddddd;
    margin: 2px 0px;
}
